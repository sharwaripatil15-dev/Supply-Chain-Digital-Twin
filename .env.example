# Copy to .env and fill in.
ANTHROPIC_API_KEY=
# Leave empty to use the in-memory cache only.
REDIS_URL=redis://localhost:6379/0

# Per-router mock switches. true = serve mock/mock_data.py; false = call core/
# (unimplemented core stubs raise NotImplementedError -> HTTP 501). Flip one at a time as modules land.
USE_MOCK_NETWORK=true     # GET /network, /forecast, /surrogate
USE_MOCK_SIMULATE=true    # POST /simulate, /montecarlo
USE_MOCK_CHAOS=true       # GET /chaos
USE_MOCK_RECOVER=true     # POST /recover
USE_MOCK_PARSE=true       # POST /parse (false needs ANTHROPIC_API_KEY)

# Frontend -> backend base URL (read by Vite at build/dev time)
VITE_API_URL=http://localhost:8000
