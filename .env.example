# Copy to .env and fill in.
ANTHROPIC_API_KEY=
# Leave empty to use the in-memory cache only.
REDIS_URL=redis://localhost:6379/0

# Per-router mock switches. true = serve mock/mock_data.py; false = call core/
# (unimplemented core stubs raise NotImplementedError -> HTTP 501). Flip one at a time as modules land.
USE_MOCK_NETWORK=true     # GET /network, /forecast, /surrogate
USE_MOCK_SIMULATE=true    # POST /simulate, /montecarlo
USE_MOCK_CHAOS=true       # GET /chaos
USE_MOCK_RECOVER=true     # POST /recover
USE_MOCK_PARSE=true       # POST /parse (false needs ANTHROPIC_API_KEY)
USE_MOCK_WEATHER=false    # /weather/*: true = never call the weather providers (offline: disk cache, else calm weather)

# Weather & hazard providers: free, no key needed. Weather data by Open-Meteo.com (CC BY 4.0); earthquakes: USGS.
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_FLOOD_URL=https://flood-api.open-meteo.com/v1/flood
OPENMETEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
USGS_QUAKE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_week.geojson
GDACS_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
# Optional commercial Open-Meteo plan: switches to the customer-* endpoints.
OPENMETEO_API_KEY=
WEATHER_TIMEOUT_S=5
WEATHER_CACHE_TTL=1800    # seconds (30 min); responses are also kept on disk in DATA_DIR/weather_cache for offline use

# Frontend -> backend base URL (read by Vite at build/dev time)
VITE_API_URL=http://localhost:8000
